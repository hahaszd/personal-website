---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  projects,
  STATUS_LABEL_EN,
  EXPLORATIONS,
} from '../../data/projects';
---

<BaseLayout
  title="Projects"
  description="What I'm building and what I've built, told as practice notes: what I made, how I made it, what I ran into, and the outcome."
>
  <h1>Projects</h1>
  <p>
    Alongside writing about what AI <em>is</em>, this is what I've actually
    built. Each project is told as a practice note — dated, honest about status,
    and linked to the source where it's public.
  </p>

  {
    projects.map((project) => (
      <article class="project">
        <h2>
          {project.name}
          <span class={`status status-${project.status}`}>
            {STATUS_LABEL_EN[project.status]}
          </span>
        </h2>
        <p>{project.en.tagline}</p>
        <dl>
          <dt>What</dt>
          <dd>{project.en.what}</dd>
          <dt>How</dt>
          <dd>{project.en.how}</dd>
          <dt>Outcome</dt>
          <dd>{project.en.result}</dd>
          <dt>Date</dt>
          <dd>{project.date}</dd>
        </dl>
        {project.links.length > 0 && (
          <p>
            {project.links.map((link, i) => (
              <>
                {i > 0 && '　'}
                <a href={link.href} target="_blank" rel="noopener">
                  {link.label} →
                </a>
              </>
            ))}
          </p>
        )}
      </article>
    ))
  }

  <section class="explorations">
    <h2>{EXPLORATIONS.en.heading}</h2>
    <p>{EXPLORATIONS.en.body}</p>
  </section>
</BaseLayout>
